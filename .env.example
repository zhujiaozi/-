# 崇祯规则引擎 配置
# 复制此文件为 .env，用记事本编辑

# 模式: deterministic (内置引擎) 或 proxy (调用外部LLM)
CZ_MODE=proxy

# 缓存模式 (仅 proxy 模式生效):
#   off        = 默认, 按场景过滤工具, 适合 DeepSeek 等不支持缓存的
#   unified    = 统一工具集, 适合 OpenAI/Claude 等支持 prompt caching 的
CZ_CACHE_MODE=off

# 用 proxy 模式时填一个:
DEEPSEEK_API_KEY=sk-xxxxxxxx
# OPENAI_API_KEY=sk-xxxxxxxx
